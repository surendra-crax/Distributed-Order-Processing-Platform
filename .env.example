# Application Port
SERVER_PORT=8080

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=order_processing_db
DB_USER=postgres
DB_PASSWORD=postgres

# Kafka Configuration (KRaft)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ORDERS=order.events
KAFKA_TOPIC_ORDERS_DLT=order.events.DLT
KAFKA_CONSUMER_GROUP=order-processing-group

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Outbox Relaying Configuration
OUTBOX_POLLING_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
